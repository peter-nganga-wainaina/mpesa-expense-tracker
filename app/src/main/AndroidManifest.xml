<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Backfill: reads M-Pesa messages already in the inbox. Viable because the APK is sideloaded. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Lets setup ask to be exempt from battery optimization, so the SMS receiver keeps working. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update only: reads version.txt and the APK from the app's GitHub Releases. Nothing is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the downloaded update be handed to Android's installer (the user still confirms it). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ExpenseTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press on the app icon: "Check for updates", the way out of a release that crashes on start. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The update safety net. Its own process starts without the main process's startup (WorkManager's
          initializer and the rest), so a release that crashes there can still install its fix.
          Exported for the launcher shortcut; all it can do is offer an install the user confirms.
        -->
        <activity
            android:name=".update.UpdateActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/check_for_updates"
            android:process=":updater"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.Dialog" />

        <!-- BROADCAST_SMS: only the system can deliver SMS broadcasts to this receiver. -->
        <receiver
            android:name=".sms.MpesaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notify.CategoryActionReceiver"
            android:exported="false" />

        <!--
          Shares the downloaded update APK with Android's installer, read-only and per request. In the
          updater's process: the installer reading the file must not start the main process, or a
          release that crashes on start would crash again here and never install its fix.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":updater">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>